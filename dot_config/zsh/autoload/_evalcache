# Cache generated shell initialization. Usage: _evalcache COMMAND [ARG]...
function _evalcache () {
  local executable=${commands[$1]:-$1} output cacheFile temporary data cmdHash
  local -A metadata

  # A mise shim can stay unchanged while the selected tool version changes.
  if [[ $executable == ${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims/* ]]; then
    executable=$(mise which "$1") || return
  fi
  executable=${executable:A}
  [[ -x $executable ]] || { print -u2 -- "evalcache: command not found: $1"; return 127; }

  if [[ $ZSH_EVALCACHE_DISABLE == true ]]; then
    output=$("$@") || return
    eval "$output"
    return
  fi

  zmodload -F zsh/stat b:zstat
  zstat -H metadata -- "$executable" || return
  data="${(j: :)${(q)@}}:$executable:$metadata[inode]:$metadata[mtime]:$metadata[ctime]:$metadata[size]"
  cmdHash=$(print -rn -- "$data" | sha256sum) || return
  cmdHash=${cmdHash%% *}
  cacheFile="$ZSH_EVALCACHE_DIR/init-${1:t}-${cmdHash}.sh"

  if [[ ! -s $cacheFile ]]; then
    output=$("$@") || return
    [[ -n $output ]] || return 1
    mkdir -p -- "$ZSH_EVALCACHE_DIR" || return
    temporary=$(mktemp "$cacheFile.XXXXXX") || return
    if ! print -r -- "$output" >| "$temporary" || ! mv -f -- "$temporary" "$cacheFile"; then
      rm -f -- "$temporary"
      return 1
    fi
  fi
  source "$cacheFile"
}
